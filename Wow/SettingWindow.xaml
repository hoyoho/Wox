<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:wox="clr-namespace:Wow"
        xmlns:vm="clr-namespace:Wow.ViewModel"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:userSettings="clr-namespace:Wow.Infrastructure.UserSettings;assembly=Wow.Infrastructure"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Class="Wow.SettingWindow"
        mc:Ignorable="d"
        Icon="app.png"
        Title="{DynamicResource wox_settings}"
        WindowStartupLocation="CenterScreen"
        Width="1000" Height="680"
        MinWidth="780" MinHeight="520"
        MaxWidth="1280" MaxHeight="1020"
        Background="#F3F5F8"
        Closed="OnClosed"
        d:DataContext="{d:DesignInstance vm:SettingWindowViewModel}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted"/>
    </Window.CommandBindings>

    <Window.Resources>

        <!-- 调色板 -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F3F5F8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE4EA" />
        <SolidColorBrush x:Key="DividerBrush" Color="#EBEFF3" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#20242A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#69717B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
        <SolidColorBrush x:Key="NavHoverBrush" Color="#ECF1F7" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#E3EDFE" />

        <CollectionViewSource Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}" x:Key="SortedFontsQuery">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Source"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}" x:Key="SortedFontsResult">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Source"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- 通用控件样式 -->
        <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- 插件列表卡片:悬停高亮 -->
        <Style x:Key="PluginCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F6FD" />
                    <Setter Property="BorderBrush" Value="#C5D7F2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Switch 开关(文字居左,开关右对齐) -->
        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="#CDD3DA"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Thumb"
                                     Width="14" Height="14"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="#E4E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关行:文字 + 右对齐 Switch -->
        <Style x:Key="SwitchRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="SwitchRowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- 顶部横排菜单项 -->
        <Style x:Key="TopMenuListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->

        <!-- ==================== 顶部横排菜单(含全局热键) ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <DockPanel>
                <!-- 右侧:无(开机/隐藏 已并入常规页左列) -->
                <ListBox x:Name="NavList"
                         SelectedIndex="0"
                         SelectionChanged="OnNavSelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource TopMenuListBoxItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem>
                        <TextBlock Text="{DynamicResource general}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{DynamicResource plugin}" />
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{DynamicResource theme}" />
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Row="2" Background="{StaticResource ContentBackgroundBrush}">

            <!-- ============ 常规(含快捷键/代理/关于) ============ -->
            <Grid x:Name="GeneralPage" Margin="22,14,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Stretch">

                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,12"
                                   Text="{DynamicResource general}" />

                        <!-- 主体双栏 -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 左卡:开机启动/不显示主窗口/语言/热键 -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Margin="0,0,7,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource startWowOnSystemStartup}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.StartWowOnSystemStartup}"
                                                      Checked="OnAutoStartupChecked" Unchecked="OnAutoStartupUncheck"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource hideOnStartup}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.HideOnStartup}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="{DynamicResource language}" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,2"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding Languages}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="LanguageCode"
                                                  SelectedValue="{Binding Language}" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="{DynamicResource woxHotkey}" />
                                        <wox:HotkeyControl Grid.Column="1"
                                                           x:Name="HotkeyControl"
                                                           Margin="0,2"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center"
                                                           HotkeyChanged="OnHotkeyChanged"
                                                           Loaded="OnHotkeyControlLoaded" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 右卡:便携/失焦/隐藏托盘/记住/全屏 -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    Margin="7,0,0,0">
                                <StackPanel>
                                    <Grid Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource portableMode}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding PortableMode}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource hideWowWhenLoseFocus}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.HideWhenDeactive}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource hideNotifyIcon}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.HideNotifyIcon}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource rememberLastLocation}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.RememberLastLaunchLocation}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                    <Grid Style="{StaticResource SwitchRowStyle}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SwitchRowLabelStyle}"
                                                   Text="{DynamicResource ignoreHotkeysOnFullscreen}" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding Settings.IgnoreHotkeysOnFullscreen}"
                                                      Style="{StaticResource SwitchToggleStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 搜索选项 -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Style="{StaticResource CardStyle}"
                                    Margin="0,14,7,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding ShouldUsePinyin}">
                                            <TextBlock Text="{DynamicResource ShouldUsePinyin}" />
                                        </CheckBox>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource querySearchPrecision}" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,2"
                                                  ItemsSource="{Binding QuerySearchPrecisionStrings}"
                                                  SelectedItem="{Binding Settings.QuerySearchPrecisionString}" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource lastQueryMode}" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,2"
                                                  ItemsSource="{Binding LastQueryModes}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.LastQueryMode}" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource maxShowResults}" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,2"
                                                  ItemsSource="{Binding MaxResultsRange}"
                                                  SelectedItem="{Binding Settings.MaxResultsToShow}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 代理 -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource CardStyle}"
                                    Margin="7,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Settings.Proxy.Enabled}">
                                            <TextBlock Text="{DynamicResource enableProxy}" />
                                        </CheckBox>
                                        <Button Grid.Column="1"
                                                MinWidth="100" Padding="12,4"
                                                Click="OnTestProxyClick"
                                                IsEnabled="{Binding Settings.Proxy.Enabled}"
                                                Content="{DynamicResource testProxy}" />
                                    </Grid>
                                    <Grid IsEnabled="{Binding Settings.Proxy.Enabled}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource server}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                                 Text="{Binding Settings.Proxy.Server}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource port}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                                 Text="{Binding Settings.Proxy.Port, TargetNullValue={x:Static sys:String.Empty}}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource userName}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                                 Text="{Binding Settings.Proxy.UserName}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}"
                                                   Text="{DynamicResource password}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                                                 Text="{Binding Settings.Proxy.Password}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 关于 -->
                        </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
<TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{DynamicResource about}" />
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ActivatedTimes, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,4" />

                                <!-- row1: 网站 -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{DynamicResource website}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Hyperlink NavigateUri="{Binding Github, Mode=OneWay}"
                                                   RequestNavigate="OnRequestNavigate">
                                            <Run Text="{Binding Github, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"
                                          IsChecked="{Binding Settings.AutoUpdates}">
                                    <TextBlock Text="{DynamicResource autoUpdates}" />
                                </CheckBox>

                                <!-- row2: 版本 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="Version" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Version}" />
                                </Grid>
                                <CheckBox Grid.Row="2" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"
                                          IsChecked="{Binding Settings.UpdateToPrereleases}">
                                    <TextBlock Text="{DynamicResource updateToPrereleases}" />
                                </CheckBox>

                                <!-- row3: 发布说明 -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="{DynamicResource releaseNotes}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Hyperlink NavigateUri="{Binding ReleaseNotes, Mode=OneWay}"
                                                   RequestNavigate="OnRequestNavigate">
                                            <Run Text="{Binding ReleaseNotes, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Row="3" Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        MinWidth="130"
                                        Padding="12,5"
                                        Margin="12,0,0,0"
                                        Click="OnCheckUpdates"
                                        Content="{DynamicResource checkUpdates}" />
                                <Image Grid.Row="1" Grid.RowSpan="3" Grid.Column="2"
                                       Source="{Binding AppIcon}"
                                       Width="76" Height="76"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform" />
                            </Grid>
                        </Border>
                                    </StackPanel>
            </Grid>


            <!-- ============ 插件 ============ -->
            <Grid x:Name="PluginPage" Margin="22,14,22,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PageHeadingStyle}"
                               Margin="0"
                               VerticalAlignment="Center"
                               Text="{DynamicResource plugin}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="14,0,0,0"
                               Text="{DynamicResource searchPlugins}" />
                    <TextBox x:Name="PluginFilterBox"
                             Grid.Column="2"
                             Width="220"
                             Height="24"
                             Margin="8,0,14,0"
                             VerticalContentAlignment="Center"
                             VerticalAlignment="Center"
                             TextChanged="PluginFilterBox_TextChanged" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               Foreground="{StaticResource AccentBrush}">
                        <Hyperlink NavigateUri="{Binding Plugin, Mode=OneWay}"
                                   RequestNavigate="OnRequestNavigate">
                            <Run Text="{DynamicResource browserMorePlugins}" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PluginList" ItemsSource="{Binding PluginViewModels}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PluginCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>

                                        <!-- 顶部信息行:点击切换内联展开 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Cursor="Hand" MouseLeftButtonUp="OnPluginCardActivate">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="44" Height="44"
                                                        Margin="0,0,12,0"
                                                        Background="#F0F2F5"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Top">
                                                    <Image Source="{Binding Image, IsAsync=True}"
                                                           Width="28" Height="28" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PluginPair.Metadata.Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionStyle}">
                                                            <Run Text="{Binding PluginPair.Metadata.Author, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PluginPair.Metadata.Description}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding PluginPair.Metadata.Description}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,5,0,0">
                                                        <Run Text="{Binding InitilizaTime, Mode=OneWay}" />
                                                        <Run Text="   " />
                                                        <Run Text="{Binding QueryTime, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 目录 + 启用/禁用 -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="14,0,0,0">
                                                <Button Content="{DynamicResource pluginDirectory}"
                                                        MinWidth="76"
                                                        Padding="10,5"
                                                        Margin="0,0,8,0"
                                                        Click="OnPluginDirectoryClick" />
                                                <Button MinWidth="76"
                                                        Padding="10,5"
                                                        Click="OnPluginToggleClick"
                                                        Content="{Binding EnableButtonText}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 内联展开区:插件设置面板 + 查询热键 + 附加操作 -->
                                        <Border Margin="0,12,0,0"
                                                Padding="4,14,4,2"
                                                BorderThickness="0,1,0,0"
                                                BorderBrush="#E3E7EC">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- 插件自定义设置区:统一外框 -->
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Background="#FAFBFC"
                                                        Padding="2"
                                                        Visibility="{Binding HasSettingsVisibility}">
                                                    <ContentControl Content="{Binding SettingsControl}" />
                                                </Border>

                                                <!-- 底部:触发关键字 / 自定义热键 两行编辑(均拉伸) -->
                                                <Grid Margin="0,16,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 触发关键字 -->
                                                    <Grid Grid.Row="0" Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Text="{DynamicResource actionKeywords}" />
                                                        <TextBox Grid.Column="1"
                                                                 Height="24"
                                                                 FontSize="13"
                                                                 VerticalContentAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 LostFocus="OnPluginKeywordLostFocus"
                                                                 Loaded="OnPluginKeywordLoaded" />
                                                    </Grid>

                                                    <!-- 自定义热键 -->
                                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Text="{DynamicResource customQueryHotkey}" />
                                                        <wox:HotkeyControl Grid.Column="1"
                                                                           Height="24"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Center"
                                                                           HotkeyChanged="OnPluginHotkeyChanged"
                                                                           Loaded="OnPluginHotkeyLoaded" />
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ 主题 ============ -->
            <Grid x:Name="ThemePage" Margin="22,14,22,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource PageHeadingStyle}"
                               Margin="0"
                               VerticalAlignment="Center"
                               Text="{DynamicResource theme}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               Foreground="{StaticResource AccentBrush}">
                        <Hyperlink NavigateUri="{Binding Theme, Mode=OneWay}"
                                   RequestNavigate="OnRequestNavigate">
                            <Run Text="{DynamicResource browserMoreThemes}" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="0,4,16,0"
                             SelectedItem="{Binding SelectedTheme}"
                             ItemsSource="{Binding Themes}"
                             ItemContainerStyle="{StaticResource TopMenuListBoxItemStyle}" />

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 主题预览 -->
                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="14"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="500" Style="{DynamicResource WindowBorderStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="50" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBox Text="{DynamicResource helloWow}" IsReadOnly="True"
                                                     Style="{DynamicResource QueryTextSuggestionBoxStyle}" Grid.Row="0" />
                                            <TextBox Text="{DynamicResource helloWow}" IsReadOnly="True"
                                                     Style="{DynamicResource QueryBoxStyle}" Grid.Row="0" />
                                            <ContentControl Grid.Row="1">
                                                <wox:ResultListBox DataContext="{Binding PreviewResults, Mode=OneTime}"
                                                                   Visibility="Visible" />
                                            </ContentControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 字体设置 -->
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource queryBoxFont}" />
                                <ComboBox Grid.Column="1" Grid.Row="0" Margin="0,3"
                                          ItemsSource="{Binding Source={StaticResource SortedFontsQuery}}"
                                          SelectedItem="{Binding SelectedQueryBoxFont}" />
                                <ComboBox Grid.Column="2" Grid.Row="0" Margin="10,3,0,3"
                                          ItemsSource="{Binding SelectedQueryBoxFont.FamilyTypefaces}"
                                          SelectedItem="{Binding SelectedQueryBoxFontFaces}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding AdjustedFaceNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Value}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="0" Grid.Row="1"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource resultItemFont}" />
                                <ComboBox Grid.Column="1" Grid.Row="1" Margin="0,3"
                                          ItemsSource="{Binding Source={StaticResource SortedFontsResult}}"
                                          SelectedItem="{Binding SelectedResultFont}" />
                                <ComboBox Grid.Column="2" Grid.Row="1" Margin="10,3,0,3"
                                          ItemsSource="{Binding SelectedResultFont.FamilyTypefaces}"
                                          SelectedItem="{Binding SelectedResultFontFaces}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding AdjustedFaceNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Value}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                 </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
