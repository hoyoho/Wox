<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- todo run installer again, should not display uninstall -->
  <?ifdef env.APPVEYOR_BUILD_VERSION ?>
  <?define WowVersion  = $(env.APPVEYOR_BUILD_VERSION) ?>
  <?else?>
  <?define WowVersion  = "1.5.0"?>
  <?endif?>
  <Bundle
    Name="Wow Full Installer $(var.WowVersion)"
    Version="$(var.WowVersion)"
    Manufacturer="Wow"
    UpgradeCode="f96edd7f-00c8-44b8-8ac7-1d500bbbaeea"
    DisableModify="yes"
    DisableRemove="yes"
    IconSourceFile="..\Wow\Resources\app.ico"
    Copyright="Wow"
    >
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.HyperlinkLicense">
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        LogoFile="logo.png"
        SuppressRepair="yes"
        SuppressOptionsUI="yes"
        ShowVersion="yes"
        ThemeFile="InstallerTheme.xml"
        xmlns:bal="http://schemas.microsoft.com/wix/BalExtension" />
    </BootstrapperApplicationRef>

    <!-- default to choose -->
    <Variable Name="WowCheckbox" Value="1"/>
    <Variable Name="EverythingCheckbox" Value="1"/>

    <Chain>
      <!--passive / no ui install. use exe cause cannot find a way to install msi with command line argument-->
      <ExePackage
        SourceFile="Everything-1.4.1.1032.x64-Setup.exe"
        InstallCommand="/S"
        InstallCondition="EverythingCheckbox" 
      />
      <ExePackage
        Id="WowPackage"
        SourceFile="..\Output\packages\Wow-$(var.WowVersion).exe"
        InstallCondition="WowCheckbox"
      />
    </Chain>
  </Bundle>
</Wix>
